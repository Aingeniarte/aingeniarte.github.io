---
import RecentBlogPosts from '@components/generic/RecentBlogPosts.astro';
import MobileSocials from '@components/home/MobileSocials.astro';
import { Button, Card, Pill } from '@eliancodes/brutal-ui';
import Layout from '@layouts/Default.astro';

const builtWith = [
  { name: 'Ciberseguridad', url: '/blog/' },
  { name: 'Telecomunicaciones', url: '/blog/' },
  {
    name: 'Redes',
    url: '/blog/',
  },
  { name: 'Desarrollo Web', url: '/blog/' },
  {
    name: 'Inteligencia Artificial',
    url: '/blog/',
  },
  { name: 'Programación', url: '/blog/' },
  { name: 'Ingenieria', url: ' /blog/' },
];
---

<Layout
  title='INICIO'
  pageTitle='!Aingeniarte | INICIO'
  description='Aingeniarte es una lugar donde encontraras contenido practico sobre ciberseguridad,telecomunicaciones e ingenieria.'
>
  <main class='bg-pink-theme p-6'>
    <MobileSocials />
    <section id='about' class='grid md:grid-cols-8 gap-8 mt-4'>
      <h2 class='hidden'>Sobre !Aingeniarte</h2>
      <div class='col-span-4'>
        <Card>
          <div class='flex flex-col justify-between items-start gap-4'>
            <p class='mt-2 outfit break-words text-2xl md:text-3xl lg:text-4xl'>
              Ciberseguridad,<br /> telecomunicaciones <br /> y tecnologia </p>
                
              
            </p>
            <p class='mt-2 outfit break-words text-lg md:text-xl lg:text-2xl'>
              Aprende divirtiéndote en forma clara y práctica sobre ciberseguridad, telecomunicaciones e ingeniería.
            </p>
            <Button target={'_self'} href='/blog/'>
              Explorar artículos &rarr;
            </Button>
          </div>
        </Card>
      </div>
      <div class='col-span-2'>
        <Card>
          <h2 class='text-2xl md:text-4xl lg:text-6xl mb-8 dm-serif'>
            Aprende sobre
          </h2>
          <ul class='flex gap-4 flex-wrap'>
            {
              builtWith.map((item) => (
                <li>
                  <Pill>
                    <a
                      class='sanchez text-xs'
                      href={item.url}
                      target='_self'
                      rel='noopener'
                      title={`Ir a ${item.name}`}
                    >
                      {item.name}
                    </a>
                  </Pill>
                </li>
              ))
            }
          </ul>
        </Card>
      </div>
      <div class='col-span-2'>
        <Card>
          <h2 class='text-xl md:text-2xl lg:text-3xl mb-4 dm-serif'>
            ¿Que es !Aingeniarte?
          </h2>
          <p class='poppins'>
            !Aingeniarte es un espacio pensado para convertir temas que en un principio pueden parecer complejos en conocimientos y aprendizajes claros, practicos y entretenidos para quienes disfrutan entendiendo, creando y avanzando en este enorme mundo digital.    
                    
            
          </p>
        </Card>
      </div>
    </section>
    <RecentBlogPosts />
  </main>
  <script>
  const colores = [
    "#ff6b6b",
    "#ffd166",
    "#06d6a0",
    "#4cc9f0",
    "#9b5de5",
    "#f15bb5",
  ];

  const tarjetas = document.querySelectorAll("#about > div > :first-child");
  const coloresMezclados = [...colores].sort(() => Math.random() - 0.5);

  tarjetas.forEach((tarjeta, posicion) => {
    (tarjeta as HTMLElement).style.backgroundColor =
      coloresMezclados[posicion % coloresMezclados.length];
  });
</script>
</Layout>
